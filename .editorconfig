root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,h}]
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Vendored from ESPAltherma: keep the upstream formatting (tabs) so updates stay a plain copy.
[components/altherma_hub/{converters,labeldef}.h]
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
